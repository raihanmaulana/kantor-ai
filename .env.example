# Salin file ini menjadi .env untuk mode lokal.
# Di Vercel, isi variabel yang sama lewat Settings → Environment Variables.

# Kunci untuk hook Claude Code mengirim tugas (wajib). Buat yang panjang dan acak.
OFFICE_WRITE_KEY=ganti-dengan-kunci-tulis-acak

# Kunci untuk membuka halaman kantor (disarankan). Kosongkan bila halaman boleh dilihat siapa saja.
OFFICE_READ_KEY=ganti-dengan-kunci-baca-acak

# Diisi otomatis oleh integrasi Upstash Redis di Vercel. Untuk mode lokal boleh dikosongkan (pakai memori).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Zona waktu untuk menghitung "tugas hari ini", dalam menit dari UTC. Default 420 (WIB).
# OFFICE_TZ_OFFSET_MINUTES=420
