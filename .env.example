# Salin file ini menjadi .env untuk mode lokal.
# Di Vercel, isi variabel yang sama lewat Settings → Environment Variables, lalu Redeploy.

# Kunci untuk membuka halaman (wajib bila memakai data Supabase asli). Buat yang panjang dan acak.
OFFICE_READ_KEY=ganti-dengan-kunci-baca-acak

# Data keuangan dari Arus (money-manager). Kantor AI HANYA MEMBACA.
SUPABASE_URL=https://xxxx.supabase.co               # sama dengan NEXT_PUBLIC_SUPABASE_URL di Arus
SUPABASE_SERVICE_ROLE_KEY=                           # Supabase → Project Settings → API → service_role (RAHASIA)
FINANCE_OWNER_EMAIL=email-akun-arus@contoh.com

# Alamat web Arus untuk tombol "Buka Arus" (opsional).
# ARUS_URL=https://arus-anda.vercel.app

# Coba dengan data contoh tanpa Supabase (abaikan tiga variabel di atas).
# FINANCE_DEMO=1

# Zona waktu dalam menit dari UTC. Default 420 (WIB).
# OFFICE_TZ_OFFSET_MINUTES=420
