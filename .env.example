# Salin file ini menjadi .env untuk mode lokal.
# Di Vercel, isi variabel yang sama lewat Settings → Environment Variables.

# Kunci untuk membuat, memindahkan, dan menghapus task (wajib). Buat yang panjang dan acak.
OFFICE_WRITE_KEY=ganti-dengan-kunci-tulis-acak

# Kunci untuk membuka halaman (disarankan). Kosongkan bila halaman boleh dilihat siapa saja.
OFFICE_READ_KEY=ganti-dengan-kunci-baca-acak

# Hook Claude Code (opsional). Isi 1 untuk mengizinkan /api/event membuat task dari Claude Code.
CLAUDE_HOOK_ENABLED=0

# Zona waktu untuk menghitung "selesai hari ini", dalam menit dari UTC. Default 420 (WIB).
# OFFICE_TZ_OFFSET_MINUTES=420

# Diisi otomatis oleh integrasi Upstash Redis di Vercel. Untuk mode lokal boleh dikosongkan
# (data disimpan di data/kantor-ai.json).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------- Keuangan dari Arus (money-manager), opsional ----------
# Bendahara membaca data Supabase Arus (HANYA MEMBACA) dan menampilkan saldo di brankas.
# Wajib juga mengisi OFFICE_READ_KEY, supaya data keuangan tidak bisa dilihat publik.
# SUPABASE_URL=https://xxxx.supabase.co            # sama dengan NEXT_PUBLIC_SUPABASE_URL di Arus
# SUPABASE_SERVICE_ROLE_KEY=                        # Supabase → Project Settings → API → service_role (RAHASIA)
# FINANCE_OWNER_EMAIL=email-akun-arus@contoh.com
# FINANCE_DEMO=1                                    # coba dengan data contoh tanpa Supabase
